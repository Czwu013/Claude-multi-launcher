@{
    'help.lines' = @(
        'claude-multi-launcher - unofficial community tool, not affiliated with Anthropic.',
        'Usage: .\claude-multi.ps1 <command> [arguments]',
        '',
        '  list                              List all profiles',
        '  add <name> [options]              Create a profile (login data, workspace memory, dedicated folder, temp dir, desktop shortcut)',
        '      -DataDir -ConfigDir -WorkspaceDir -TempDir <path>   Set one location explicitly',
        '      -Root <dir>                   Put everything except login data under <dir>\<name>\',
        '      -ReuseDefault                 Reuse the default Claude app login data (login data only)',
        '      -NoShortcut  -Note <text>  -WhatIf (preview only, creates nothing)',
        '  launch <name>                     Start the profile',
        '  scan [<folder>]                   Find existing clones on this PC (read-only)',
        '  import <name> -DataDir <path>     Register an existing clone as a profile (nothing is copied or changed)',
        '  open <name>                       Open the dedicated folder in Explorer',
        '  paths <name>                      Show all locations and the isolation check result',
        '  set-path <name> <type> <path>     Change one location (type: data config workspace temp outputs)',
        '                                    Updates the config and creates an empty folder; never moves old data',
        '  rename <old> <new>                Rename (folder names stay the same)',
        '  remove <name>                     Remove the profile record and desktop shortcut (preview, then confirm; data folders are always kept)',
        '  shortcut <name>                   Recreate the desktop shortcut',
        '  lang [auto|zh|en]                 Show or set the interface language',
        '  help                              Show this help'
    )

