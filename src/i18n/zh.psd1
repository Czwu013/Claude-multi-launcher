@{
    'help.lines' = @(
        'claude-multi-launcher —— 非官方社区工具，与 Anthropic 无关。',
        '用法：.\claude-multi.ps1 <命令> [参数]',
        '',
        '  list                              列出所有 profile',
        '  add <名称> [选项]                 创建 profile（登录数据、工作区记忆、专用文件夹、临时目录、桌面快捷方式）',
        '      -DataDir -ConfigDir -WorkspaceDir -TempDir <路径>   单独指定某个位置',
        '      -Root <目录>                  把除登录数据外的目录都放到 <目录>\<名称>\ 下',
        '      -ReuseDefault                 沿用默认 Claude 应用已登录的数据（只沿用登录数据）',
        '      -NoShortcut  -Note <备注>  -WhatIf（只预演，不创建任何东西）',
        '  launch <名称>                     启动',
        '  scan [<文件夹>]                   扫描这台电脑上已有的 clone（只读）',
        '  import <名称> -DataDir <路径>     把已有的 clone 登记为 profile（只登记，不复制不改动）',
        '  open <名称>                       在资源管理器中打开专用文件夹',
        '  paths <名称>                      查看各位置和独立性检查结果',
        '  set-path <名称> <类型> <路径>     修改某个位置（类型：data config workspace temp outputs）',
        '                                    只更新配置并创建空目录，不会移动旧数据',
        '  rename <旧名称> <新名称>          改名（各目录名称不变）',
        '  remove <名称>                     删除 profile 记录和桌面快捷方式（先预览再确认；数据目录一律保留）',
        '  shortcut <名称>                   重新创建桌面快捷方式',
        '  lang [auto|zh|en]                 查看或设置界面语言',
        '  help                              显示本说明'
    )

